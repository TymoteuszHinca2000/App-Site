{
    "name": "appandsite-base",
    "private": true,
    "engines": {
        "node": ">=20.0.0"
    },
    "type": "module",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "translate": "npm run translate:pot && npm run translate:update",
        "translate:pot": "wp i18n make-pot . ./resources/lang/appandsite.pot --include=\"theme.json,patterns,app,resources\"",
        "translate:update": "for file in ./resources/lang/*.po; do wp i18n update-po ./resources/lang/appandsite.pot $file; done",
        "translate:compile": "npm run translate:mo && npm run translate:js",
        "translate:js": "wp i18n make-json ./resources/lang --pretty-print",
        "translate:mo": "wp i18n make-mo ./resources/lang ./resources/lang"
    },
    "devDependencies": {
        "@roots/vite-plugin": "^1.0.0",
        "@tailwindcss/typography": "^0.5.19",
        "@tailwindcss/vite": "^4.0.0",
        "laravel-vite-plugin": "^2.0.0",
        "prettier": "^3.6.2",
        "prettier-plugin-blade": "^2.1.21",
        "prettier-plugin-tailwindcss": "^0.6.14",
        "tailwindcss": "^4.0.0",
        "vite": "^7.0.0"
    },
    "dependencies": {
        "@googlemaps/js-api-loader": "^2.1.3",
        "alpinejs": "^3.15.0",
        "aos": "^2.3.4",
        "glightbox": "^3.3.1",
        "headroom.js": "^0.12.0",
        "lenis": "^1.3.26",
        "magic.css": "^1.4.8",
        "swiper": "^12.0.3"
    }
}
