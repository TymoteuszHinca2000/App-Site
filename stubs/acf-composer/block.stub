<?php

namespace DummyNamespace;

use Log1x\AcfComposer\Block;
use Log1x\AcfComposer\Builder;

class DummyClass extends Block
{
    /**
     * The block name.
     *
     * @var string
     */
    public $name = 'DummyTitle';

    /**
     * The block slug.
     *
     * @var string
     */
    public $slug = 'DummySlug';

    /**
     * The block description.
     *
     * @var string
     */
    public $description = '';

    /**
     * The block category.
     *
     * @var string
     */
    public $category = 'appandsite';

    /**
     * The block icon.
     *
     * @var string|array
     */
    public $icon = 'editor-ul';

    /**
     * The block keywords.
     *
     * @var array
     */
    public $keywords = [];

    /**
     * The block post type allow list.
     *
     * @var array
     */
    public $post_types = [DummyPostTypes];

    /**
     * The internal ACF block version.
     *
     * @var int
     */
    public $blockVersion = 3;

    /**
     * The parent block type allow list.
     *
     * @var array
     */
    public $parent = [];

    /**
     * The ancestor block type allow list.
     *
     * @var array
     */
    public $ancestor = [];

    /**
     * The default block mode.
     *
     * @var string
     */
    public $mode = 'preview';

    /**
     * The default block spacing.
     *
     * @var array
     */
    public $spacing = [
        'padding' => null,
        'margin' => null,
    ];

    /**
     * The supported block features.
     *
     * @var array
     */
    public $supports = [
        DummySupports
    ];

    /**
     * The block preview example data.
     *
     * @var array
     */
    public $example = [
        // fill example data for acf fields
    ];

    /**
     * The block template.
     *
     * @var array
     */
    public $template = [];

    /**
     * Data to be passed to the block before rendering.
     */
    public function with(): array
    {
        return get_fields() ?: [];
    }

    /**
     * The block field group.
     */
    public function fields(): array
    {
        $fields = Builder::make('DummySnake');

        $fields
            //->addWysiwyg('content', [
            //    'label' => 'Treść',
            //])
            ;

        return $fields->build();
    }

    /**
     * Assets enqueued with 'enqueue_block_assets' when rendering the block.
     *
     * @link https://developer.wordpress.org/block-editor/how-to-guides/enqueueing-assets-in-the-editor/#editor-content-scripts-and-styles
     */
    public function assets(array $block): void
    {
        //
    }
}
